# Copy this file to `.env.local` and fill in the values.
# Vite only exposes vars prefixed with VITE_ to the frontend.
# NOTE: restart the dev server after changing env vars — Vite reads them at startup.

# Supabase — from your project dashboard: Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend base URL — the AI/Backend engineer's FastAPI server.
# Leave BLANK to run the frontend in mock mode (no backend needed).
# When the backend is ready, set it, e.g.:
#   VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

# Force mock mode even when VITE_API_BASE_URL is set (optional): true | false
# VITE_USE_MOCK=false
